<mvc:View
    controllerName="zf110.controller.ApprovalPosting"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:fl="sap.ui.layout.form"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:layout="sap.ui.layout"
    xmlns:uiTable="sap.ui.table"
    xmlns:core="sap.ui.core"
    height="100%"
>
    <f:DynamicPage id="idApprovalDynamicPage" headerExpanded="true" showFooter="true" fitContent="true">
        
        <f:title>
            <f:DynamicPageTitle id="_IDGenDynamicPageTitle1">
                <f:heading>
                    <Title id="_IDGenTitle1" text="Vendor Payment Approval" />
                </f:heading>
                <f:expandedContent>
                    <Label id="_IDGenLabel11" text="Review and post pending vendor payment proposals" />
                </f:expandedContent>
                <f:snappedContent>
                    <Label id="_IDGenLabel21" text="Review proposals" />
                </f:snappedContent>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader id="_IDGenDynamicPageHeader1">
                <layout:Grid id="_IDGenGrid1" defaultSpan="XL6 L6 M6 S12" vSpacing="0" width="100%">
                    
                    <VBox id="_IDGenVBox4" class="sapUiTinyMarginTop">
                        <Label
                            id="_IDGenLabel8"
                            text="Search Proposal by ID"
                            design="Bold"
                            class="sapUiTinyMarginBottom"
                        />
                        <HBox id="_IDGenHBox1" alignItems="Center" width="100%">
                            <Input
                                id="idIdentificationInput"
                                placeholder="Enter ID Number (e.g., 2026000001)..."
                                width="100%"
                                class="sapUiSmallMarginEnd"
                            />
                            <Button
                                id="idGoButton"
                                text="Search"
                                icon="sap-icon://search"
                                type="Emphasized"
                                press="onGoPress"
                                width="100px"
                            />
                        </HBox>
                    </VBox>

                    <VBox id="_IDGenVBox3" class="sapUiTinyMarginTop">
                        <Label
                            id="_IDGenLabel7"
                            text="Reviewing User"
                            design="Bold"
                            class="sapUiTinyMarginBottom"
                        />
                        <RadioButtonGroup id="idUserRadioGroup" columns="2" selectedIndex="0">
                            <buttons>
                                <RadioButton id="rbUser1" text="Lead Reviewer" />
                                <RadioButton id="rbUser3" text="Finance VP" />
                            </buttons>
                        </RadioButtonGroup>
                    </VBox>
                </layout:Grid>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <smartTable:SmartTable
                id="idSmartTable"
                entitySet="VendorPayment"
                tableType="Table"
                header="Pending Vendor Proposals"
                showRowCount="true"
                enableAutoBinding="true"
                fitContainer="true"
                width="100%"
                class="sapUiResponsiveContentPadding"
                useTablePersonalisation="true"
                ignoredFields="Approval1,Approval1Status"
                initiallyVisibleFields="Db_Key,IdNo,CompanyCode,Supplier,SupplierFullName,InvoiceDate,PostingDate,PaymentDays,InvoiceNo,TransactionCurrency,InvoiceValue,AmountAlreadyPaid,BalanceToBePaid,AmountProposal,JournalEntry,JournalEntryType,FiscalYear,FiscalPeriod,HouseBank,HouseBankAccount,GlAccount,ProfitCenter,Material,MaterialType"
            >
                <uiTable:Table
                    id="_IDGenTable"
                    selectionMode="MultiToggle"
                    width="100%"
                >
                    <uiTable:columns>
                    </uiTable:columns>
                </uiTable:Table>
            </smartTable:SmartTable>
        </f:content>

        <f:footer>
            <OverflowToolbar id="_IDGenOverflowToolbar1">
                <ToolbarSpacer id="_IDGenToolbarSpacer1" />
                <Button 
                    id="idApproveBtn" 
                    text="Approve Proposal" 
                    icon="sap-icon://accept" 
                    type="Accept" 
                    press="onApprovePress" />
                <Button 
                    id="idDeleteBtn" 
                    text="Reject Proposal" 
                    icon="sap-icon://decline" 
                    type="Reject" 
                    press="onDeletePress" />
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>