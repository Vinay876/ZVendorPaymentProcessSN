{
  "_version": "1.80.0",
  "sap.app": {
    "id": "zf110",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.22.0",
      "toolsId": "c42a96be-2ac0-42ef-9e7b-9516f2b52aed"
    },
    "dataSources": {
      "ZFI_BIN_VENDOROPENREPORT_VAN": {
        "uri": "/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='ZFI_BIN_VENDOROPENREPORT_VAN',Version='0001')/$value/",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "localService/mainService/ZFI_BIN_VENDOROPENREPORT_VAN.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZFI_BIN_VENDOROPENREPORT/",
        "type": "OData",
        "settings": {
          "annotations": [
            "ZFI_BIN_VENDOROPENREPORT_VAN"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "zf110-Display": {
          "semanticObject": "zf110",
          "action": "Display",
          "title": "{{zf110-Display.flpTitle}}",
          "subTitle": "{{zf110-Display.flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "config": {
      "fullWidth": true
    },
    "dependencies": {
      "minUI5Version": "1.142.10",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zf110.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "zf110.view",
        "async": true,
        "viewPath": "zf110.view"
      },
      "routes": [
        {
          "name": "RouteView1",
          "pattern": ":?query:",
          "target": [
            "TargetView1"
          ]
        },
        {
          "name": "RouteVendorReport",
          "pattern": "VendorReport/{query}",
          "target": [
            "TargetVendorReport"
          ]
        },
        {
          "name": "RouteInvoicePosting",
          "pattern": "InvoicePosting",
          "target": [
            "TargetInvoicePosting"
          ]
        }
      ],
      "targets": {
        "TargetView1": {
          "id": "View1",
          "name": "View1"
        },
        "TargetVendorReport": {
          "id": "VendorReport",
          "name": "VendorReport"
        },
        "TargetInvoicePosting": {
          "id": "InvoicePosting",
          "name": "InvoicePosting"
        }
      }
    },
    "rootView": {
      "viewName": "zf110.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}